# Loaded by anything run with --env=testing, e.g.
#   php artisan migrate:fresh --env=testing
#
# Without this file that flag silently falls back to .env and rebuilds the
# real development database, so keep DB_DATABASE pointed at a throwaway one.
# The values here mirror the <php> block in phpunit.xml.

APP_NAME="Coco Craft"
APP_ENV=testing
# Throwaway key for the test database only — deliberately NOT the one in .env,
# since this file is committed.
APP_KEY=base64:IozGgPQl2mARz/tkTtE9QOPI3Ls8IeUSgIXkRzNDVH4=
APP_DEBUG=true
APP_URL=http://127.0.0.1:8000

BCRYPT_ROUNDS=4

LOG_CHANNEL=stack
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=chocolate_test
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=array
CACHE_STORE=array
QUEUE_CONNECTION=sync
MAIL_MAILER=array
FILESYSTEM_DISK=local
BROADCAST_CONNECTION=null
